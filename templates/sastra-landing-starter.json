{
  "version": "0.4",
  "title": "SastraPro High-Speed Landing Page - PageSpeed Ultra Starter",
  "type": "container",
  "content": [
    {
      "id": "sastra_landing_root",
      "elType": "container",
      "isInner": false,
      "settings": {
        "content_width": "boxed",
        "boxed_width": {
          "unit": "px",
          "size": 900
        },
        "flex_direction": "column",
        "flex_align_items": "center",
        "gap": {
          "unit": "px",
          "size": 28
        },
        "padding": {
          "unit": "px",
          "top": "64",
          "right": "20",
          "bottom": "64",
          "left": "20",
          "isLinked": false
        },
        "background_background": "classic",
        "background_color": "#ffffff"
      },
      "elements": [
        {
          "id": "landing_badge",
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "⚡ 100/100 CORE WEB VITALS GUARANTEED",
            "header_size": "span",
            "typography_typography": "custom",
            "typography_font_size": {
              "unit": "px",
              "size": 12
            },
            "typography_font_weight": "800",
            "typography_letter_spacing": {
              "unit": "px",
              "size": 1.5
            },
            "title_color": "#16a34a"
          }
        },
        {
          "id": "landing_h1",
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "Solusi Cepat & Modern untuk Bisnis Digital Kamu",
            "header_size": "h1",
            "align": "center",
            "typography_typography": "custom",
            "typography_font_size": {
              "unit": "px",
              "size": 42
            },
            "typography_font_weight": "800",
            "typography_line_height": {
              "unit": "em",
              "size": 1.2
            },
            "title_color": "#0f172a"
          }
        },
        {
          "id": "landing_subheadline",
          "elType": "widget",
          "widgetType": "text-editor",
          "settings": {
            "editor": "<p style=\"text-align: center; font-size: 19px; line-height: 1.6; color: #475569; max-width: 680px; margin: 0 auto;\">Tingkatkan konversi penjualan hingga 3x lipat dengan halaman web yang terbuka kilat di bawah 1 detik tanpa lag di smartphone.</p>"
          }
        },
        {
          "id": "landing_cta_button",
          "elType": "widget",
          "widgetType": "button",
          "settings": {
            "text": "Mulai Sekarang Gratis",
            "link": {
              "url": "#order"
            },
            "size": "lg",
            "align": "center",
            "button_text_color": "#ffffff",
            "background_color": "#2563eb",
            "border_radius": {
              "unit": "px",
              "top": "8",
              "right": "8",
              "bottom": "8",
              "left": "8",
              "isLinked": true
            },
            "typography_typography": "custom",
            "typography_font_weight": "700"
          }
        },
        {
          "id": "landing_hero_media",
          "elType": "widget",
          "widgetType": "image",
          "settings": {
            "image": {
              "url": "https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=1200&h=675&auto=format&fit=crop&q=80",
              "id": ""
            },
            "image_size": "full",
            "aspect_ratio": "16/9",
            "width": {
              "unit": "%",
              "size": 100
            },
            "image_border_radius": {
              "unit": "px",
              "top": "12",
              "right": "12",
              "bottom": "12",
              "left": "12",
              "isLinked": true
            }
          }
        }
      ]
    }
  ]
}
